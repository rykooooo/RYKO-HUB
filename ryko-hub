-- GLOBAL COLOR APPLICATION

local function applyGlobalColor(hex)
    hex = tostring(hex):gsub("%s+", "")

    if hex:sub(1, 1) == "#" then
        hex = hex:sub(2)
    end

    if not hex:match("^%x%x%x%x%x%x$") then
        return false
    end

    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)

    local newColor = Color3.fromRGB(r, g, b)

    currentHex = "#" .. hex:upper()
    RED = newColor

    -- Main interface accents

    hubTitle.TextColor3 = RED
    minimize.TextColor3 = RED
    close.TextColor3 = RED

    openFrontal.BackgroundColor3 = RED

    -- Secondary interface accents

    frontalTitle.TextColor3 = RED
    frontalMinimize.TextColor3 = RED
    frontalClose.TextColor3 = RED

    frontalBubble.TextColor3 = RED

    -- Floating main button

    bubble.TextColor3 = RED

    -- Settings accents

    applyColor.BackgroundColor3 = RED
    colorPreview.BackgroundColor3 = RED

    -- Preserve toggle states

    if enabled then
        toggle.BackgroundColor3 = RED
    end

    if not frontalEnabled then
        frontalToggle.BackgroundColor3 = RED
    end

    -- Update preview and labels

    hexInput.Text = currentHex
    previewLabel.Text = "Current: " .. currentHex

    return true
end

