-- FRONTAL MOVEMENT

local frontalEnabled = false
local frontalConnection
local wasGrounded = false

local function stopFrontal()
    frontalEnabled = false

    if frontalConnection then
        frontalConnection:Disconnect()
        frontalConnection = nil
    end

    frontalToggle.Text = "FRONTAL JUMP: OFF"
    frontalToggle.BackgroundColor3 = RED
end

local function startFrontal()
    stopFrontal()
    frontalEnabled = true

    local character = player.Character

    if not character then
        frontalEnabled = false
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        frontalEnabled = false
        return
    end

    wasGrounded = humanoid.FloorMaterial ~= Enum.Material.Air

    frontalConnection = RunService.Heartbeat:Connect(function()
        if not frontalEnabled then return end

        if not root.Parent or humanoid.Health <= 0 then
            stopFrontal()
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then return end

        local look = camera.CFrame.LookVector
        local forward = Vector3.new(look.X, 0, look.Z)

        if forward.Magnitude > 0 then
            forward = forward.Unit

            local velocity = root.AssemblyLinearVelocity

            root.AssemblyLinearVelocity = Vector3.new(
                forward.X * frontalSpeed,
                velocity.Y,
                forward.Z * frontalSpeed
            )
        end

        local grounded =
            humanoid.FloorMaterial ~= Enum.Material.Air

        if grounded and not wasGrounded then
            humanoid.Jump = true
        end

        wasGrounded = grounded
    end)

    frontalToggle.Text = "FRONTAL JUMP: ON"
    frontalToggle.BackgroundColor3 = Color3.fromRGB(45, 145, 85)
end

frontalToggle.MouseButton1Click:Connect(function()
    if frontalEnabled then
        stopFrontal()
    else
        startFrontal()
    end
end)

